{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gackun-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "MAIL_TO": "gaku.yoshikawa@gmail.com",
    "ALLOWED_ORIGINS": "https://gackun.com,http://localhost:3000"
  }
  // GMAIL_USER / GMAIL_APP_PASSWORD は secret で設定 (npx wrangler secret put GMAIL_USER)
}
