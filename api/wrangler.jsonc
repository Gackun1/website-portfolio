{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gackun-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "ALLOWED_ORIGINS": "https://gackun.com,http://localhost:3000",
    "GMAIL_USER": "gaku090707@gmail.com",
    "MAIL_TO": "gaku090707@gmail.com"
  }
  // GMAIL_APP_PASSWORD は secret で設定
}
